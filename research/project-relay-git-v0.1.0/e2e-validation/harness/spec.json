{
  "daily": {
    "expect": { "dailies": 1, "master": false },
    "hedge": {
      "PR #14 claimed in session notes but no remote exists": "PR\\s*#?\\s*14\\b",
      "session notes claim the test suite is green": "\\b(?:test suite|tests?)\\b[^.\\n]{0,60}\\b(?:green|passing|passed|all pass)\\b|\\ball green\\b"
    },
    "forbid": {
      "a PR number other than the one in the session notes": "\\bPR\\s*#\\s*(?!14\\b)\\d+",
      "an issue number (none exist in this fixture)": "\\bissues?\\s*#\\s*\\d+",
      "a deployment claim": "\\b(?:deployed|deployment) to (?:staging|production|prod)\\b",
      "a merge or approval that never happened": "\\b(?:merged into|approved by)\\b"
    },
    "require": {
      "the per-merchant key scoping decision": "per[- ]merchant",
      "the abandoned middleware approach": "middleware",
      "Marta as the blocker owner": "Marta",
      "webhook re-emission as the open question": "webhook"
    }
  },

  "master": {
    "expect": { "dailies": 2, "master": true },
    "hedge": {
      "feat/legacy-cart, which was deleted": "feat/legacy-cart",
      "the inherited 48-tests claim": "48 tests",
      "the inherited staging deployment claim": "deployed to staging|staging (?:is )?up to date|deployment status",
