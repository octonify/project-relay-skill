      "an invented precedence rule": "takes precedence over|precedence order is",
      "an approval that never happened": "\\bapproved by\\b"
    },
    "require": {
      "Version incremented past 3.0": "Version:\\s*(?:3\\.[1-9]|[4-9]\\.|\\d\\d)",
      "the async 202 refund decision from the 2026-06-28 Daily": "202\\b",
      "the observed 5/second rate ceiling from the 2026-07-02 Daily": "5\\s*/\\s*second|5 per second|five per second",
      "production refund credentials as the blocker": "credential",
      "both Dailies marked incorporated": "2026-06-28[\\s\\S]{0,400}2026-07-02",
      "the do-not-repeat synchronous refund approach": "synchronous"
    }
  },

  "full": {
    "expect": { "dailies": 1, "master": true },
    "hedge": {},
    "forbid": {
      "signature verification presented as working": "signature verification (?:works|is working|is verified|passes|passing|is complete|is done|functions)",
