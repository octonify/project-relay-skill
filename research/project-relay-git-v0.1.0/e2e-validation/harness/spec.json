    "require": {
      "Master is Version 1.0": "Version:\\s*1\\.0",
      "the raw-body-before-JSON-parser constraint": "raw body|raw request body|express\\.raw",
      "Dana as the person chasing the signing secret": "Dana",
      "the signing secret as the blocker": "signing secret",
      "do not rewrite webhook.ts": "(?:not|don't|do not|avoid)[^.\\n]{0,60}rewrit",
      "nothing deployed and no PR": "no (?:PR|pull request)|nothing is deployed|not deployed",
      "signature verification explicitly recorded as not working/untested": "signature[- ]?(?:checking |verification )?[^.\\n]{0,140}(?:not implemented|no implementation|is a stub|still a stub|untested|not tested|cannot be tested|unverified|not verified)|(?:not implemented|untested|is a stub)[^.\\n]{0,140}signature"
    }
